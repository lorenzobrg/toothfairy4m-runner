# Copy to .env for docker compose

RUNNER_TASK_NAME=toothfairy4m_runner.process_job
RUNNER_QUEUE=runner_bite_dev
RUNNER_WORKER_ID=bite_classification-worker

# Use host.docker.internal when ToothFairy4M runs on host machine
RUNNER_API_BASE_URL=http://web-dev:8000
RUNNER_API_TOKEN=dev-runner-token

# Adjust to your reachable Redis broker
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3

# Adjust to your reachable S3-compatible endpoint (Garage)
OBJECT_STORAGE_ENDPOINT_URL=http://garage:3900
OBJECT_STORAGE_REGION=garage
OBJECT_STORAGE_ACCESS_KEY_ID=tf4m-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=tf4m-secret-key
OBJECT_STORAGE_BUCKET=toothfairy4m-dev
OBJECT_STORAGE_USE_SSL=0
OBJECT_STORAGE_VERIFY_SSL=0
OBJECT_STORAGE_ADDRESSING_STYLE=path
OBJECT_STORAGE_KEY_PREFIX=

# Map modality slug to algorithm image available to host Docker daemon
ALGORITHM_IMAGE_MAP={"bite_classification":"toothfairy4m-bite_classification:latest"}
# Command run inside the algorithm container (defaults to python /app/entrypoint.py)
ALGORITHM_CONTAINER_CMD=python /app/entrypoint.py
# Default targets RTX 2080 Ti (sm_75). Extend with more architectures if needed.
TORCH_CUDA_ARCH_LIST=7.5

RUNNER_WORKDIR_ROOT=/tmp/toothfairy4m-runner

# Optional compose overrides
RUNNER_CONCURRENCY=1
RUNNER_PREFETCH_MULTIPLIER=1
RUNNER_IMAGE=toothfairy4m-bite_classification:latest
RUNNER_CONTAINER_NAME=toothfairy4m-bite_classification-runner
